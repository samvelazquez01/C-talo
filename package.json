{
  "name": "agendabarber",
  "version": "1.0.0",
  "description": "Plataforma multi-negocio para barberías y peluquerías con costo cero",
  "main": "frontend/js/app.js",
  "type": "module",
  "scripts": {
    "test": "node --test worker/tests/availability.test.js",
    "seed": "node scripts/seed-firestore.js",
    "worker:dev": "cd worker && npx wrangler dev",
    "worker:deploy": "cd worker && npx wrangler deploy",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes"
  },
  "keywords": ["barberia", "citas", "reservas", "pwa", "cloudflare-worker", "firebase-spark"],
  "author": "AgendaBarber",
  "license": "MIT"
}
